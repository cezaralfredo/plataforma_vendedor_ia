# ─────────────────────────────────────────────────────────────
# Hermes Configuration - Example
# Copy to ~/.hermes/config.yaml and adjust values
# ─────────────────────────────────────────────────────────────

# MCP Gateway endpoint (externo via Nginx Proxy Manager)
# Ex: https://api.seudominio.com/mcp-gateway
gateway:
  base_url: "https://api.seudominio.com/mcp-gateway"
  timeout: 30
  headers:
    X-Gateway-Key: "${MCP_GATEWAY_KEY}"  # Defina no ambiente

# Perfis disponíveis
# Subagentes (agendador, financeiro, notificador) foram migrados para o n8n.
# O Hermes atua unicamente como a inteligência conversacional no WhatsApp (orquestrador).
profiles:
  - orquestrador

# Configuração de logging
logging:
  level: "INFO"
  format: "json"

# Kanban (desativado - toda a automação e filas de background são gerenciadas pelo n8n)
kanban:
  enabled: false