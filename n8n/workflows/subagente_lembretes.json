{
  "name": "Subagente Lembretes - Envio de Lembretes Diários via Hermes",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "schedule-cron-node",
      "name": "Disparo Diário (08:00)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [180, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://agenda-api:8000/mcp",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.API_KEY || '') }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"cron_reminder\",\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"listar_pendentes_notificacao\",\n    \"arguments\": {}\n  }\n}",
        "options": {}
      },
      "id": "http-query-pending",
      "name": "Consultar Pendências na API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 300]
    }
  ],
  "connections": {
    "Disparo Diário (08:00)": {
      "main": [
        [
          {
            "node": "Consultar Pendências na API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
