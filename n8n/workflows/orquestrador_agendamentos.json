{
  "name": "Orquestrador de Agendamentos - n8n",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agendamento/criar",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-create-appointment",
      "name": "Webhook Criar Agendamento",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 300],
      "webhookId": "agendamento-criar"
    },
    {
      "parameters": {
        "jsCode": "// Extrai os dados enviados pelo Hermes\nconst body = $input.first().json.body || $input.first().json;\n\nreturn [{\n  json: {\n    client_name: body.client_name || body.name,\n    phone: String(body.phone || body.whatsapp_number || '').replace(/\\D/g, ''),\n    cpf_cnpj: body.cpf_cnpj ? String(body.cpf_cnpj).replace(/\\D/g, '') : null,\n    professional_id: parseInt(body.professional_id),\n    service_id: parseInt(body.service_id),\n    start_time: body.start_time,\n    end_time: body.end_time,\n    notes: body.notes || 'Agendado via Hermes WhatsApp'\n  }\n}];"
      },
      "id": "code-validate-params",
      "name": "Validar Parâmetros",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [380, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://agenda-api:8000/mcp",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.API_KEY || 'dev-api-key-change-in-production') }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"find_user\",\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"buscar_cliente_por_telefone\",\n    \"arguments\": {\n      \"phone\": \"{{ $json.phone }}\"\n    }\n  }\n}",
        "options": {}
      },
      "id": "http-find-user",
      "name": "Buscar Cliente na API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [580, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://agenda-api:8000/mcp",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.API_KEY || 'dev-api-key-change-in-production') }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"cadastrar_user\",\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"cadastrar_cliente\",\n    \"arguments\": {\n      \"name\": \"{{ $('Validar Parâmetros').first().json.client_name }}\",\n      \"phone\": \"{{ $('Validar Parâmetros').first().json.phone }}\",\n      \"whatsapp_number\": \"{{ $('Validar Parâmetros').first().json.phone }}\",\n      \"cpf_cnpj\": \"{{ $('Validar Parâmetros').first().json.cpf_cnpj || '' }}\"\n    }\n  }\n}",
        "options": {}
      },
      "id": "http-create-user",
      "name": "Cadastrar se Novo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-user-found",
              "leftValue": "={{ $json.result?.content?.[0]?.text || '' }}",
              "rightValue": "Cliente não encontrado",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-user-exists",
      "name": "Cliente Existe?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [780, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://agenda-api:8000/api/appointments",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.API_KEY || 'dev-api-key-change-in-production') }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"user_id\": {{ $json.user_id }},\n  \"professional_id\": {{ $('Validar Parâmetros').first().json.professional_id }},\n  \"service_id\": {{ $('Validar Parâmetros').first().json.service_id }},\n  \"start_time\": \"{{ $('Validar Parâmetros').first().json.start_time }}\",\n  \"end_time\": \"{{ $('Validar Parâmetros').first().json.end_time }}\",\n  \"notes\": \"{{ $('Validar Parâmetros').first().json.notes }}\"\n}",
        "options": {}
      },
      "id": "http-create-appointment",
      "name": "Criar Reserva na API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://agenda-api:8000/api/payments",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.API_KEY || 'dev-api-key-change-in-production') }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"appointment_id\": {{ $json.id }},\n  \"billing_type\": \"pix\"\n}",
        "options": {}
      },
      "id": "http-create-charge",
      "name": "Criar Cobrança Asaas PIX",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1280, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"appointment_id\": {{ $('Criar Reserva na API').first().json.id }},\n  \"payment_id\": {{ $json.id }},\n  \"invoice_url\": \"{{ $json.invoice_url }}\",\n  \"amount\": \"R$ {{ ($json.amount_cents / 100).toFixed(2) }}\",\n  \"message\": \"Reserva pré-agendada com sucesso! Para garantir seu horário, efetue o pagamento no link PIX: {{ $json.invoice_url }}\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-success",
      "name": "Responder ao Hermes com PIX",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1480, 300]
    }
