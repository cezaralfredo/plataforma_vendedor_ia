{
  "name": "Subagente Financeiro - Reconciliação & Cobrança Asaas",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "cron-trigger-15min",
      "name": "Disparo a Cada 15 Minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [180, 200]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "financeiro/verificar",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger-finance",
      "name": "Webhook Verificar Pagamentos",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 420],
      "webhookId": "financeiro-verificar"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://agenda-api:8000/api/payments/verify-recent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.API_KEY || 'dev-api-key-change-in-production') }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-verify-recent",
      "name": "Verificar Pagamentos na API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "jsCode": "// Processa os pagamentos que foram confirmados\nconst items = $input.all();\nconst confirmed = items.filter(i => ['received', 'confirmed'].includes(i.json.status));\n\nreturn [{\n  json: {\n    total_verificados: items.length,\n    confirmados_count: confirmed.length,\n    confirmados: confirmed.map(c => ({\n      id: c.json.id,\n      appointment_id: c.json.appointment_id,\n      amount: 'R$ ' + (c.json.amount_cents / 100).toFixed(2),\n      status: c.json.status\n    }))\n  }\n}];"
      },
      "id": "code-process-payments",
      "name": "Filtrar Confirmados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-confirmed-payments",
              "leftValue": "={{ $json.confirmados_count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-has-confirmed",
      "name": "Houve Novos Pagamentos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"completed\",\n  \"message\": \"Verificação financeira concluída com sucesso.\",\n  \"novos_pagamentos\": {{ $json.confirmados_count }}\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-finance-webhook",
      "name": "Responder Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1100, 420]
    }
  ],
  "connections": {
    "Disparo a Cada 15 Minutos": {
      "main": [
        [
          {
            "node": "Verificar Pagamentos na API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook Verificar Pagamentos": {
      "main": [
        [
          {
            "node": "Verificar Pagamentos na API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verificar Pagamentos na API": {
      "main": [
        [
          {
            "node": "Filtrar Confirmados",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filtrar Confirmados": {
      "main": [
        [
          {
            "node": "Houve Novos Pagamentos?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Houve Novos Pagamentos?": {
      "main": [
        [
          {
            "node": "Responder Webhook",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Responder Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
