        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"error\": {{ JSON.stringify($json.error?.message || $json.message || 'Falha no envio da confirmação pelo provedor configurado') }}\n}",
        "options": {}
      },
      "id": "defer-failed-delivery",
      "name": "Registrar Falha para Retentativa",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1840, 560]
    }
