{
  "id": "pagamento-confirmado-wf",
  "name": "Confirmação de Pagamento - Entrega WhatsApp Confiável",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pagamento-confirmado",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-payment-confirmed",
      "name": "Webhook Pagamento Confirmado",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 260],
      "webhookId": "pagamento-confirmado"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"status\": \"accepted\"\n}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "respond-payment-webhook",
      "name": "Responder Aceite à API",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [420, 140]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst deliveryId = Number(body.delivery_id);\nif (!Number.isInteger(deliveryId) || deliveryId <= 0) throw new Error('delivery_id inválido');\nreturn [{ json: { delivery_id: deliveryId } }];"
      },
      "id": "extract-webhook-delivery",
      "name": "Extrair Entrega do Webhook",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/1 * * * *"
            }
          ]
        }
      },
      "id": "schedule-pending-deliveries",
      "name": "Retentar Pendências a Cada Minuto",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [180, 520]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.AGENDA_API_URL || 'http://agenda-api:8000') + '/internal/notification-deliveries?limit=20' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.AGENDA_API_KEY || $env.API_KEY || '') }}"
            }
          ]
        },
        "options": {}
      },
      "id": "list-pending-deliveries",
      "name": "Listar Entregas Pendentes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 520]
    },
    {
      "parameters": {
        "jsCode": "const deliveries = $input.first().json.deliveries || [];\nreturn deliveries.map((delivery) => ({ json: { delivery_id: delivery.id } }));"
      },
      "id": "extract-pending-deliveries",
      "name": "Separar Entregas Pendentes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 520]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.AGENDA_API_URL || 'http://agenda-api:8000') + '/internal/notification-deliveries/' + $json.delivery_id + '/claim' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.AGENDA_API_KEY || $env.API_KEY || '') }}"
            }
          ]
        },
        "options": {}
      },
      "id": "claim-delivery",
      "name": "Assumir Entrega",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 380]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json;\nconst rawChatId = String(body.payload?.chatId || body.payload?.whatsapp || '').trim();\nif (!rawChatId) throw new Error('Cliente sem WhatsApp para confirmação de pagamento');\n\nconst phoneDigits = rawChatId.replace(/\\D/g, '');\nconst chatId = rawChatId.includes('@')\n  ? rawChatId\n  : `${phoneDigits}@s.whatsapp.net`;\n\nif (!/^\\d{12,13}@s\\.whatsapp\\.net$/.test(chatId) && !chatId.endsWith('@g.us')) {\n  throw new Error(`WhatsApp inválido para entrega: ${rawChatId}`);\n}\n\n// Determinação determinística do provedor com fallback resiliente\nconst rawProvider = String(\n  body.payload?.provider ||\n  $env.WHATSAPP_NOTIFICATION_PROVIDER ||\n  'hermes'\n).toLowerCase().trim();\n\nlet selectedProvider = 'hermes';\nlet fallbackReason = null;\n\nif (['meta', 'meta_cloud', 'cloud_api', 'whatsapp_cloud'].includes(rawProvider)) {\n  const metaToken = String($env.META_ACCESS_TOKEN || '').trim();\n  const metaPhoneId = String($env.META_PHONE_NUMBER_ID || '').trim();\n  if (!metaToken || !metaPhoneId) {\n    selectedProvider = 'hermes';\n    fallbackReason = 'Credenciais da Meta (META_ACCESS_TOKEN ou META_PHONE_NUMBER_ID) ausentes no n8n. Fallback seguro para Hermes ativado.';\n  } else {\n    selectedProvider = 'meta';\n  }\n} else {\n  selectedProvider = 'hermes';\n}\n\nconst clientName = body.payload?.client?.name || 'Cliente';\nconst serviceName = body.payload?.service?.name || 'Serviço';\nconst appointmentDate = body.payload?.appointment?.start_time || '';\nconst amountCents = Number(body.payload?.amount_cents || 0);\nconst amountFormatted = `R$ ${(amountCents / 100).toFixed(2)}`;\nconst formattedMessage = body.payload?.formatted_message || '';\n\nconst metaTemplateName = String($env.META_PAYMENT_TEMPLATE_NAME || 'confirmacao_pagamento').trim();\nconst metaLanguage = String($env.META_TEMPLATE_LANGUAGE || 'pt_BR').trim();\nconst metaMessageType = String($env.META_MESSAGE_TYPE || 'template').toLowerCase().trim();\n\nlet metaPayload;\nif (metaMessageType === 'text') {\n  metaPayload = {\n    messaging_product: 'whatsapp',\n    recipient_type: 'individual',\n    to: phoneDigits,\n    type: 'text',\n    text: { body: formattedMessage }\n  };\n} else {\n  metaPayload = {\n    messaging_product: 'whatsapp',\n    recipient_type: 'individual',\n    to: phoneDigits,\n    type: 'template',\n    template: {\n      name: metaTemplateName,\n      language: { code: metaLanguage },\n      components: [\n        {\n          type: 'body',\n          parameters: [\n            { type: 'text', text: String(clientName) },\n            { type: 'text', text: String(serviceName) },\n            { type: 'text', text: String(appointmentDate) },\n            { type: 'text', text: String(amountFormatted) }\n          ]\n        }\n      ]\n    }\n  };\n}\n\nreturn [{\n  json: {\n    ...body,\n    chatId,\n    phone_digits: phoneDigits,\n    selected_provider: selectedProvider,\n    provider_fallback_reason: fallbackReason,\n    meta_payload: metaPayload\n  }\n}];"
      },
      "id": "normalize-whatsapp-recipient",
      "name": "Normalizar Destinatário WhatsApp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 380]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-provider-is-meta",
              "leftValue": "={{ $json.selected_provider }}",
              "rightValue": "meta",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "route-whatsapp-provider",
      "name": "Roteador de Provedor WhatsApp",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 380]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.META_WHATSAPP_API_URL || 'https://graph.facebook.com/v21.0') + '/' + ($env.META_PHONE_NUMBER_ID || '') + '/messages' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.META_ACCESS_TOKEN || '') }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.meta_payload) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "send-whatsapp-meta",
      "name": "Enviar Confirmação pela Meta Cloud API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1580, 260],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.HERMES_WHATSAPP_BRIDGE_URL || 'http://hermes:3000') + '/send' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chatId\": \"{{ $json.chatId }}\",\n  \"message\": {{ JSON.stringify($json.payload.formatted_message) }}\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "send-whatsapp-hermes",
      "name": "Enviar Confirmação pelo WhatsApp Nativo Hermes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1580, 480],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.AGENDA_API_URL || 'http://agenda-api:8000') + '/internal/notification-deliveries/' + $('Assumir Entrega').first().json.delivery.id + '/sent' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.AGENDA_API_KEY || $env.API_KEY || '') }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"provider_message_id\": {{ JSON.stringify($json.messages?.[0]?.id || $json.key?.id || $json.messageId || $json.id || null) }}\n}",
        "options": {}
      },
      "id": "acknowledge-delivery",
      "name": "Confirmar Entrega na API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
