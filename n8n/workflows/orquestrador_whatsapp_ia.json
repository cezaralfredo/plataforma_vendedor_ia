      "id": "webhook-meta-inbound",
      "name": "Webhook Meta Oficial",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [160, 440],
      "webhookId": "whatsapp-meta-inbound"
