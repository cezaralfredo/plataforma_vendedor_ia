        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"check_avail\",\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"verificar_disponibilidade\",\n    \"arguments\": {\n      \"date\": \"{{ $fromAI('date') }}\",\n      \"service_id\": {{ $fromAI('service_id', null) }}\n    }\n  }\n}"
