        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"list_services\",\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"listar_servicos\",\n    \"arguments\": {}\n  }\n}"
