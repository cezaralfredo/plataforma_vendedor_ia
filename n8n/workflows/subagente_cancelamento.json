{
  "name": "Subagente Cancelamento - Cancelamento & Liberação de Horário",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agendamento/cancelar",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-cancel-appointment",
      "name": "Webhook Cancelar Reserva",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 300],
      "webhookId": "agendamento-cancelar"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://agenda-api:8000/api/appointments/{{ $json.body.appointment_id || $json.appointment_id }}/cancel",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.API_KEY || 'dev-api-key-change-in-production') }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-cancel-api",
      "name": "Cancelar na API Agenda",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.HERMES_WHATSAPP_BRIDGE_URL || 'http://hermes:3000') + '/send' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chatId\": \"{{ $('Webhook Cancelar Reserva').first().json.body?.phone || '' }}\",\n  \"message\": \"Seu agendamento #{{ $json.id }} foi cancelado com sucesso. O horário foi liberado na nossa agenda. Quando quiser marcar novamente, é só nos chamar!\"\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "http-notify-cancel-hermes",
      "name": "Avisar Cancelamento via WhatsApp Hermes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"appointment_id\": {{ $('Cancelar na API Agenda').first().json.id }},\n  \"status\": \"cancelled\",\n  \"message\": \"Agendamento cancelado com sucesso e horário liberado.\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-cancel-success",
      "name": "Responder 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Webhook Cancelar Reserva": {
      "main": [
        [
          {
            "node": "Cancelar na API Agenda",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cancelar na API Agenda": {
      "main": [
        [
          {
            "node": "Avisar Cancelamento via WhatsApp Hermes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Avisar Cancelamento via WhatsApp Hermes": {
      "main": [
        [
          {
            "node": "Responder 200 OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
